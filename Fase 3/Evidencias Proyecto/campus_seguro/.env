# URL fija de retorno después del logout de Auth0.
# Debe coincidir EXACTAMENTE con una de las URLs en Auth0 Dashboard
# → Application → Settings → Allowed Logout URLs
# Usar la misma que pusiste allá (localhost O 127.0.0.1, no ambas)
AUTH0_LOGOUT_RETURN_URL=http://localhost:8000/login/

